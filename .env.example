# Copy this file to .env and adjust for your GPU
# cp .env.example .env

MODEL_NAME=Qwen/Qwen3-ASR-1.7B

# --- GPU VRAM Guide ---
# 6 GB  (RTX 3060):    GPU_MEMORY_UTILIZATION=0.80  MAX_MODEL_LEN=2048
# 8 GB  (RTX 3070):    GPU_MEMORY_UTILIZATION=0.85  MAX_MODEL_LEN=4096
# 12 GB (RTX 3080 Ti): GPU_MEMORY_UTILIZATION=0.90  MAX_MODEL_LEN=8192
# 16 GB+:              GPU_MEMORY_UTILIZATION=0.90  MAX_MODEL_LEN=16384
GPU_MEMORY_UTILIZATION=0.85

# Max context tokens — 4096 is plenty for ASR (transcriptions are short)
# warning: too much will increase VRAM usage and might throw an error when starting up
MAX_MODEL_LEN=4096

HOST=0.0.0.0
PORT=8000
GRPC_PORT=50051
